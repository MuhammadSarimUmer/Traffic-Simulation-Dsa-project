  <property name="styleSheet">
   <string notr="true">/* --- Main Dialog --- */
QWidget#LoginDialog {
        background-image: url(:/images/login_background.png);
        background-repeat: no-repeat;
        background-position: center;
        background-attachment: fixed;
}

/* --- Centered Form Card --- */
QFrame#loginForm {
        background-color: rgba(0, 0, 0, 0.75);
        border-radius: 20px;
        max-width: 450px;
        min-width: 450px;
        padding: 20px;
}

/* --- Labels inside the card --- */
QFrame#loginForm QLabel {
        color: white;
        font-weight: bold;
        font-size: 14px;
}
QFrame#loginForm QLabel#titleLabel {
        color: white;
        font-weight: bold;
        font-size: 24px;
        padding-bottom: 10px;
}
QFrame#loginForm QLabel#statusLabel {
        color: #FFD700; /* Gold */
}

/* --- Line Edits inside the card --- */
QFrame#loginForm QLineEdit {
        background-color: rgba(0, 0, 0, 0.6);
        border: 1px solid #00AEEF;
        border-radius: 15px;
        padding: 12px;
        padding-right: 45px;
        color: white;
        font-size: 14px;
}
QFrame#loginForm QLineEdit:focus {
        border: 2px solid #FFFFFF;
}

/* --- Password Toggle Button --- */
QFrame#loginForm QPushButton#togglePasswordButton {
        background-color: transparent;
        border: none;
        padding: 0px;
        margin: 0px;
        min-width: 30px;
        max-width: 30px;
        min-height: 30px;
        max-height: 30px;
}
QFrame#loginForm QPushButton#togglePasswordButton:hover {
        background-color: rgba(255, 255, 255, 0.1);
        border-radius: 5px;
}

/* --- Buttons inside the card --- */
QFrame#loginForm QPushButton {
        background-color: #00AEEF;
        color: white;
        font-weight: bold;
        font-size: 14px;
        border-radius: 15px;
        padding: 12px;
        margin-top: 10px;
}
QFrame#loginForm QPushButton:hover {
        background-color: #009BCF;
}
QFrame#loginForm QPushButton:pressed {
        background-color: #007AAC;
}

/* --- 'Sign Up' Button --- */
QFrame#loginForm QPushButton#signupButton {
        background-color: transparent;
        border: 2px solid #00AEEF;
}
QFrame#loginForm QPushButton#signupButton:hover {
        background-color: rgba(0, 174, 239, 0.2);
}
QFrame#loginForm QPushButton#signupButton:pressed {
        background-color: rgba(0, 174, 239, 0.4);
}

/* --- 'Exit' Button --- */
QFrame#loginForm QPushButton#exitButton {
        background-color: #D32F2F; /* Red */
        border: none;
}
QFrame#loginForm QPushButton#exitButton:hover {
        background-color: #E53935; /* Lighter Red */
}
QFrame#loginForm QPushButton#exitButton:pressed {
        background-color: #C62828; /* Darker Red */
}</string>
